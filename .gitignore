```gitignore
# =========================
# macOS
# =========================
.DS_Store
.AppleDouble
.LSOverride


# =========================
# IntelliJ IDEA / Android Studio
# =========================
.idea/
*.iml
*.iws
*.ipr

# IntelliJ local workspace
workspace.xml
modules.xml


# =========================
# Gradle
# =========================
.gradle/
build/

# Gradle local configuration
local.properties


# =========================
# Java
# =========================
*.class

# JVM crash logs
hs_err_pid*
replay_pid*

# Java compiler argument files
*.args


# =========================
# Native / JNI
# =========================

# CMake build directories
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Native build output
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# Native generated/build directories
native/build/
jni/build/


# =========================
# Generated JNI / Java artifacts
# =========================

# Generated JNI headers (only ignore these if generated by javac/javah)
# *.h

# Generated Java/native binaries
*.jar
*.class


# =========================
# Logs / temporary files
# =========================
*.log
*.tmp
*.swp
*.swo
*~
```
spark-warehouse
derby.log
metastore_db

